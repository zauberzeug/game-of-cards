#!/usr/bin/env bash
# Plugin-bundled goc wrapper.
#
# Claude Code auto-prepends ${plugin}/bin to the Bash tool's PATH while the
# plugin is enabled, so skill bodies can keep calling plain `goc <verb>`.
# This wrapper invokes the bundled engine directly, by the path of its launcher
# file inside the plugin's own `goc/` package.
# No venv, no uv, no first-call latency.

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)"
PLUGIN_ROOT="$(dirname -- "$SCRIPT_DIR")"

# Prefer python3; fall back to python for environments where only `python` exists.
if command -v python3 > /dev/null 2>&1; then
    PYTHON=python3
elif command -v python > /dev/null 2>&1; then
    PYTHON=python
else
    echo "goc: 'python3' not found on PATH. Install Python 3.10+ from python.org." >&2
    exit 127
fi

# Run the engine through its launcher file, not `-m goc.cli`: `-m` puts the working
# directory first on sys.path, so a repo's own `goc/` package or a module named after
# one the engine imports would run instead of the bundled engine (goc/_launch.py).
exec env PYTHONPATH="${PLUGIN_ROOT}${PYTHONPATH:+:$PYTHONPATH}" "$PYTHON" "$PLUGIN_ROOT/goc/_launch.py" "$@"
